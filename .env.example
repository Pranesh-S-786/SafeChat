# SafeChat Environment Variables
# Create a free project at https://supabase.com
# Paste your project credentials below:

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SMTP Email Configuration (for sending real 6-digit OTP codes)
# You can set these here or configure them directly in the SafeChat UI settings modal:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="SafeChat Verification" <your-email@gmail.com>
